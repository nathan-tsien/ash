{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "running",
        "paused",
        "awaiting_input",
        "completed",
        "failed",
        "cancelled"
      ],
      "description": "Lifecycle states for a praxis task."
    },
    "CreateTaskRequest": {
      "type": "object",
      "description": "Inbound payload for creating a task.",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_input": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "StartTaskRequest": {
      "type": "object",
      "description": "Body for starting a task's first turn.",
      "properties": {
        "user_input": { "type": "string" },
        "skill_hint": {
          "type": "string",
          "description": "Optional name of a registered skill to prefer for this task. A hint, not a lock: the model may still select a different skill. Unregistered hints are ignored."
        },
        "skill_hints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional list of registered skill names to prefer for this task. Hints, not locks: unregistered names are ignored. Unioned with skill_hint (which is retained for backward compatibility)."
        }
      },
      "required": ["user_input"],
      "additionalProperties": false
    },
    "SendMessageRequest": {
      "type": "object",
      "description": "Body for sending a follow-up user message into a running task.",
      "properties": {
        "text": { "type": "string" }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "AnswerRequest": {
      "type": "object",
      "description": "Body for answering a pending message_ask_user question.",
      "properties": {
        "ask_id": { "type": "string" },
        "answer": { "type": "string" }
      },
      "required": ["ask_id", "answer"],
      "additionalProperties": false
    },
    "CreateProjectRequest": {
      "type": "object",
      "description": "Inbound payload for creating a project.",
      "properties": {
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "ProjectSummary": {
      "type": "object",
      "description": "Summary of a project returned by create/list.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    },
    "TaskSummary": {
      "type": "object",
      "description": "Summary of a task returned by create/get/list.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false
    },
    "TaskList": {
      "type": "object",
      "description": "A page of tasks. `next_cursor` is an opaque cursor for the next page; null/absent means no more pages.",
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/TaskSummary" } },
        "next_cursor": { "type": ["string", "null"] }
      },
      "required": ["items"],
      "additionalProperties": false
    },
    "ResourceDescriptor": {
      "type": "object",
      "description": "Discovery descriptor for a registered resource. v0.2.0 emits only skills; plugin/mcp/connector are forward-shaped. See the resource-registry design doc.",
      "properties": {
        "id": { "type": "string", "description": "Stable identifier; the value clients pass as a skill hint." },
        "kind": { "type": "string", "description": "One of: skill | plugin | mcp | connector. v0.2.0: always \"skill\"." },
        "display_name": { "type": "string", "description": "Human-facing label. v0.2.0: equals id." },
        "description": { "type": "string", "description": "One-line what/when. Load-bearing: also the model's routing signal." },
        "version": { "type": ["string", "null"], "description": "Optional semver from SKILL.md frontmatter." },
        "icon": { "type": ["string", "null"] },
        "source": { "type": "string", "description": "Provenance: repo | user | plugin | system." },
        "scope": { "type": "string", "description": "Visibility: global | tenant | project. v0.2.0: always \"global\"." },
        "binding": { "type": "string", "description": "Binding semantics: hint | enable | authorize. Skills are always \"hint\"." },
        "enabled": { "type": ["boolean", "null"], "description": "Only meaningful for enable/authorize bindings; null for hint." }
      },
      "required": ["id", "kind", "display_name", "description", "scope", "binding"],
      "additionalProperties": false
    },
    "SkillList": {
      "type": "object",
      "description": "A page of skill descriptors. next_cursor null/absent means no more pages.",
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ResourceDescriptor" } },
        "next_cursor": { "type": ["string", "null"] }
      },
      "required": ["items"],
      "additionalProperties": false
    },
    "SkillDetail": {
      "type": "object",
      "description": "A skill descriptor plus its SKILL.md instructions body.",
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "icon": { "type": ["string", "null"] },
        "source": { "type": "string" },
        "scope": { "type": "string" },
        "binding": { "type": "string" },
        "enabled": { "type": ["boolean", "null"] },
        "instructions": { "type": ["string", "null"], "description": "SKILL.md body, frontmatter stripped." }
      },
      "required": ["id", "kind", "display_name", "description", "scope", "binding"],
      "additionalProperties": false
    },
    "ProjectList": {
      "type": "object",
      "description": "A page of projects. `next_cursor` is an opaque cursor for the next page; null/absent means no more pages.",
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ProjectSummary" } },
        "next_cursor": { "type": ["string", "null"] }
      },
      "required": ["items"],
      "additionalProperties": false
    },
    "ErrorBody": {
      "type": "object",
      "description": "Uniform error response body. `code` is a stable, machine-dispatchable string (open set; consumers must tolerate unknown codes). `message` is human-readable and not stable.",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "object", "additionalProperties": true }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  }
}
