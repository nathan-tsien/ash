# @ash/web environment template.
# Copy to `.env.local` (gitignored) and adjust. See docs/web-configuration.md.
#
# The app runs fully standalone with NO variables set: the fake praxis client
# drives the Workbench and needs no backends. Set the values below to run
# against real iam + praxis.

# Praxis transport: "fake" (default, local fixture, no network) or "http" (real
# backend via the BFF). NEXT_PUBLIC_* is inlined at build time — rebuild / restart
# `dev` after changing it.
NEXT_PUBLIC_PRAXIS_TRANSPORT=fake

# praxis backend base URL the BFF (/api/praxis/...) forwards to. Server-only.
# Required when NEXT_PUBLIC_PRAXIS_TRANSPORT=http.
PRAXIS_BASE_URL=http://localhost:8091

# iam auth service base URL. The iam client calls ${IAM_BASE_URL}/v1/apps/ash.
# Server-only.
IAM_BASE_URL=http://localhost:8090
