# @ash/web environment template.
# Copy to `.env.local` (gitignored) and adjust. See docs/web-configuration.md.
#
# The app ALWAYS talks to the real backend — the fake praxis client is unit-test
# only (AGENTS.md discipline). Run iam + praxis (below) and log in; there is no
# fake/standalone runtime mode and no transport flag.

# praxis backend base URL the BFF (/api/praxis/...) forwards to. Server-only.
PRAXIS_BASE_URL=http://localhost:8091

# iam auth service base URL. The iam client calls ${IAM_BASE_URL}/v1/apps/ash.
# Server-only.
IAM_BASE_URL=http://localhost:8090
